{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "title", "startId", "nodes"],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover": {
      "type": "string",
      "format": "uri"
    },
    "language": {
      "type": "string",
      "enum": ["ru", "en", "de", "fr", "es", "it", "pt", "zh", "ja", "ko"]
    },
    "startId": {
      "type": "integer"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "prefix": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "init": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": ["string", "number", "boolean"]
              },
              {
                "type": "object",
                "required": ["ref"],
                "properties": {
                  "ref": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "redirectTriggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "targetId"],
            "properties": {
              "condition": {
                "type": "string"
              },
              "targetId": {
                "type": "integer"
              }
            }
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "statements"],
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "conditions": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "statements": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "text"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": ["skip", "action", "finish", "redirect"]
          },
          "label": {
            "type": "string"
          },
          "text": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "key": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "entryEffects": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": ["string", "number", "boolean"]
                      }
                    }
                  }
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "nextId": {
            "type": "integer"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "id"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["name"],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "args": {
                            "type": "array",
                            "items": {
                              "type": ["string", "number", "boolean"]
                            }
                          }
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "id": {
                  "type": "integer"
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "condition": {
                  "type": "string"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["name"],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "args": {
                            "type": "array",
                            "items": {
                              "type": ["string", "number", "boolean"]
                            }
                          }
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "id": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "viewport": {
      "type": "object",
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
