  "description": "Вы заблудились в лесу и пытаетесь из него выбраться. Или не пытаетесь. Сложность: 3/5",
  "language": "ru",
  "cover": "https://i.imgur.com/2gykp3B.png",
  "startId": 1,
  "prefix": "День: {{day}}, Здоровье: {{hp}}",
  "data": {
    "init": {
      "maxHp": 6,
      "maxShoes": 2,
      "wanderedEnough": 10,
      "maxWandersPerDay": 3,
      "day": 1,
      "hp": {
        "ref": "maxHp"
      },
      "shoes": {
        "ref": "maxShoes"
      },
      "wandered": 0,
      "wanderedToday": false
    },
    "conditions": {
      "isAlive": "hp > 0",
      "isDead": "hp <= 0",
      "hasShoes": "shoes > 0",
      "hasWanderedEnough": "wandered >= wanderedEnough"
    },
    "effects": [
      {
        "name": "nextDay",
        "statements": [
          "day = day + 1",
          "wanderedToday = false",
          "hit(1)"
        ]
      },
      {
        "name": "removeShoe",
        "conditions": "hasShoes()",
        "statements": "shoes = shoes - 1"
      },
      {
        "name": "kill",
        "statements": "hp = 0"
      },
      {
        "name": "hit",
        "args": "amount",
        "conditions": "amount > 0",
        "statements": "hp = max(hp - amount, 0)"
      },
      {
        "name": "heal",
        "args": "amount",
        "conditions": "amount > 0 && isAlive()",
        "statements": "hp = min(hp + amount, maxHp)"
      },
      {
        "name": "wander",
        "statements": [
          "wandered = wandered + 1",
          "wanderedToday = true"
        ]
      }
    ]
  },
